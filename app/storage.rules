rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isStaff() {
      return isAdmin() || hasRole('principal');
    }

    function isValidUpload() {
      return request.resource.size < 10 * 1024 * 1024
             && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Public marketing assets — readable by anyone, writable by staff only.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Avatars — a user may replace their own; anyone signed in may view.
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if (isSignedIn() && request.auth.uid == userId && isValidUpload())
                   || isStaff();
    }

    // Student documents contain minors' personal data — staff only.
    match /students/{studentId}/{allPaths=**} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == studentId);
      allow write: if isStaff() && isValidUpload();
    }

    // Teacher documents (CV, certificates, ID).
    match /teachers/{teacherId}/{allPaths=**} {
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == teacherId);
      allow write: if (isSignedIn() && request.auth.uid == teacherId && isValidUpload())
                   || isStaff();
    }

    // Complaint attachments.
    match /complaints/{complaintId}/{allPaths=**} {
      allow read: if isStaff();
      allow write: if isSignedIn() && isValidUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
