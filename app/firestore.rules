rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- */
    /* Helpers                                                          */
    /* ---------------------------------------------------------------- */

    function isSignedIn() {
      return request.auth != null;
    }

    // Roles are set as custom claims by a Cloud Function, never by the client.
    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isStaff() {
      return hasRole('super_admin') || hasRole('admin') || hasRole('principal');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /* ---------------------------------------------------------------- */
    /* Leads — public trial registrations                               */
    /* ---------------------------------------------------------------- */

    match /leads/{leadId} {
      // Anyone may submit a registration, but only with a well-formed
      // payload and only as a brand-new 'new' lead. This prevents the public
      // form being used to inject arbitrary documents.
      // hasOnly permits a subset, so the public form's payload is fixed:
      // staff-only fields (note, owner) can never arrive from the website.
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'email', 'phone', 'country',
                         'course', 'teacherPreference',
                         'dateOfBirth', 'age',
                         'status', 'source', 'createdAt'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 40
                    && request.resource.data.country is string
                    && request.resource.data.country.size() <= 80
                    && request.resource.data.status == 'new'
                    && request.resource.data.source == 'website';

      // Leads contain personal data — never publicly readable.
      allow read: if isStaff();

      // Staff may correct the enquiry and move it through the pipeline, but
      // never rewrite its provenance: source and createdAt are immutable.
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly([
                           'name', 'email', 'phone', 'country', 'course',
                           'teacherPreference', 'dateOfBirth', 'age',
                           'status', 'note', 'owner'
                         ])
                    && request.resource.data.source == resource.data.source
                    && request.resource.data.createdAt == resource.data.createdAt;

      // Admin and principal may delete: a lead is a contact enquiry, and a
      // parent asking to be removed should be removed.
      allow delete: if hasRole('super_admin') || hasRole('admin') || hasRole('principal');
    }

    /* ---------------------------------------------------------------- */
    /* Job applications — public careers form                           */
    /* ---------------------------------------------------------------- */

    match /applications/{applicationId} {
      // Anyone may apply, but only with a well-formed payload and only as a
      // brand-new 'new' application, so the form cannot inject documents.
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'email', 'phone', 'country', 'role', 'gender',
                         'dateOfBirth', 'age', 'qualifications',
                         'experienceYears', 'availability', 'message',
                         'status', 'source', 'createdAt'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 40
                    && request.resource.data.qualifications is string
                    && request.resource.data.qualifications.size() <= 2000
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.status == 'new'
                    && request.resource.data.source == 'careers';

      // Applications contain personal data — staff only.
      allow read: if isStaff();

      allow update: if isStaff()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly([
                           'name', 'email', 'phone', 'country', 'role',
                           'gender', 'dateOfBirth', 'age', 'qualifications',
                           'experienceYears', 'availability', 'message',
                           'status', 'note'
                         ])
                    && request.resource.data.source == resource.data.source
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if hasRole('super_admin') || hasRole('admin') || hasRole('principal');
    }

    /* ---------------------------------------------------------------- */
    /* Users & profiles                                                 */
    /* ---------------------------------------------------------------- */

    match /users/{userId} {
      allow read: if isSelf(userId) || isStaff();
      // Users may edit their own profile but never their own role.
      allow update: if (isSelf(userId)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['role', 'status']))
                    || isStaff();
      allow create, delete: if isStaff();
    }

    /* ---------------------------------------------------------------- */
    /* Classes, sessions, attendance                                    */
    /* ---------------------------------------------------------------- */

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      // Teachers may update the sessions they teach (notes, status);
      // staff may write any.
      allow update: if isStaff()
                    || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create, delete: if isStaff();
    }

    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff() || isTeacher();
      allow delete: if isStaff();
    }

    /* ---------------------------------------------------------------- */
    /* Complaints                                                       */
    /* ---------------------------------------------------------------- */

    match /complaints/{complaintId} {
      allow create: if isSignedIn();
      allow read: if isStaff() || isSelf(resource.data.raisedById);
      allow update: if isStaff();
      allow delete: if hasRole('super_admin');
    }

    /* ---------------------------------------------------------------- */
    /* Leave requests                                                   */
    /* ---------------------------------------------------------------- */

    match /leaveRequests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isStaff() || isSelf(resource.data.userId);
      allow update: if isStaff();
      allow delete: if hasRole('super_admin');
    }

    /* ---------------------------------------------------------------- */
    /* Finance — staff only, never client-writable                      */
    /* ---------------------------------------------------------------- */

    match /invoices/{invoiceId} {
      allow read: if isStaff() || isSelf(resource.data.studentId);
      allow write: if isStaff();
    }

    match /payments/{paymentId} {
      allow read: if isStaff();
      // Written exclusively by Cloud Functions via the Admin SDK,
      // which bypasses these rules.
      allow write: if false;
    }

    /* ---------------------------------------------------------------- */
    /* Anything not matched above is denied                             */
    /* ---------------------------------------------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
