rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- */
    /* Helpers                                                          */
    /* ---------------------------------------------------------------- */

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Identity comes from the caller's own /users document, not from client
     * state. A user may edit their profile but never their own role (see the
     * users rules below), so this cannot be escalated from the browser.
     */
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && profile().role == role;
    }

    function myName() {
      return profile().name;
    }

    // 'admin' is the Super Admin — the highest level. There is no separate
    // super_admin claim.
    function isAdmin() {
      return hasRole('admin');
    }

    function isStaff() {
      return isAdmin() || hasRole('principal');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /* ---------------------------------------------------------------- */
    /* Leads — public trial registrations                               */
    /* ---------------------------------------------------------------- */

    match /leads/{leadId} {
      // Anyone may submit a registration, but only with a well-formed
      // payload and only as a brand-new 'new' lead. This prevents the public
      // form being used to inject arbitrary documents.
      // hasOnly permits a subset, so the public form's payload is fixed:
      // staff-only fields (note, owner) can never arrive from the website.
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'email', 'phone', 'country',
                         'course', 'teacherPreference',
                         'dateOfBirth', 'age',
                         'status', 'source', 'createdAt'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 40
                    && request.resource.data.country is string
                    && request.resource.data.country.size() <= 80
                    && request.resource.data.status == 'new'
                    && request.resource.data.source == 'website';

      // Leads contain personal data — never publicly readable.
      allow read: if isStaff();

      // Staff may correct the enquiry and move it through the pipeline, but
      // never rewrite its provenance: source and createdAt are immutable.
      allow update: if isStaff()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly([
                           'name', 'email', 'phone', 'country', 'course',
                           'teacherPreference', 'dateOfBirth', 'age',
                           'status', 'note', 'owner'
                         ])
                    && request.resource.data.source == resource.data.source
                    && request.resource.data.createdAt == resource.data.createdAt;

      // Admin and principal may delete: a lead is a contact enquiry, and a
      // parent asking to be removed should be removed.
      allow delete: if isStaff();
    }

    /* ---------------------------------------------------------------- */
    /* Job applications — public careers form                           */
    /* ---------------------------------------------------------------- */

    match /applications/{applicationId} {
      // Anyone may apply, but only with a well-formed payload and only as a
      // brand-new 'new' application, so the form cannot inject documents.
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'email', 'phone', 'country', 'role', 'gender',
                         'dateOfBirth', 'age', 'qualifications',
                         'experienceYears', 'availability', 'message',
                         'status', 'source', 'createdAt'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 40
                    && request.resource.data.qualifications is string
                    && request.resource.data.qualifications.size() <= 2000
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.status == 'new'
                    && request.resource.data.source == 'careers';

      // Applications contain personal data — staff only.
      allow read: if isStaff();

      allow update: if isStaff()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly([
                           'name', 'email', 'phone', 'country', 'role',
                           'gender', 'dateOfBirth', 'age', 'qualifications',
                           'experienceYears', 'availability', 'message',
                           'status', 'note'
                         ])
                    && request.resource.data.source == resource.data.source
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isStaff();
    }

    /* ---------------------------------------------------------------- */
    /* Users & profiles                                                 */
    /* ---------------------------------------------------------------- */

    match /users/{userId} {
      // Anyone signed in may read the directory: the messaging UI needs names
      // and roles to show who you may contact. Profiles hold no secrets.
      allow read: if isSignedIn();

      // A user may edit their own profile but never their own role or status,
      // which is what keeps the role lookup above trustworthy.
      // Staff may edit anyone, but only an admin may hand out the admin role
      // or take it away — otherwise a principal could promote themselves.
      // Self-edits may change anything except role and status — which
      // includes a teacher setting their own default meeting room.
      allow update: if (isSelf(userId)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['role', 'status']))
                    || isAdmin()
                    || (hasRole('principal')
                        && request.resource.data.role != 'admin'
                        && resource.data.role != 'admin');

      // Staff create teacher and student accounts. Self-create is permitted
      // for the caller's own uid with a non-privileged role, so a first
      // sign-in can provision a profile without granting an escalation.
      //
      // Bootstrap: the very first admin cannot be created by staff, because
      // no staff profile exists yet. A privileged self-create is therefore
      // allowed only while the sentinel document /config/bootstrap still
      // exists. Deleting that document closes this path for good.
      allow create: if isAdmin()
                    || (hasRole('principal')
                        && request.resource.data.role != 'admin')
                    || (isSelf(userId)
                        && request.resource.data.role in ['teacher', 'student'])
                    || (isSelf(userId)
                        && exists(/databases/$(database)/documents/config/bootstrap));

      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- */
    /* Classes, sessions, attendance                                    */
    /* ---------------------------------------------------------------- */

    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      // Teachers may update the sessions they teach (notes, status);
      // staff may write any.
      allow update: if isStaff()
                    || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create, delete: if isStaff();
    }

    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff() || isTeacher();
      allow delete: if isStaff();
    }

    /* ---------------------------------------------------------------- */
    /* Bootstrap sentinel                                               */
    /* ---------------------------------------------------------------- */

    match /config/bootstrap {
      // Readable so the rules above can test for it; only an admin may
      // remove it, which is the act of closing bootstrap.
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
      allow update: if false;
    }

    /* ---------------------------------------------------------------- */
    /* Messages                                                         */
    /* ---------------------------------------------------------------- */

    /**
     * Scheduled classes.
     *
     * Only Admin and Principal may set a timetable — a teacher cannot book
     * themselves work and a student cannot book a teacher. Both parties can
     * read their own class so their portal, calendar and today's board work.
     */
    match /classes/{classId} {
      allow read: if isStaff()
                  || (isSignedIn()
                      && (resource.data.teacherName == myName()
                          || resource.data.studentName == myName()));

      allow create: if isStaff()
                    && request.resource.data.keys().hasOnly([
                         'studentId', 'studentName', 'teacherId', 'teacherName',
                         'course', 'days', 'start', 'durationMin', 'zoomUrl',
                         'status', 'createdBy', 'createdAt'
                       ])
                    && request.resource.data.studentName is string
                    && request.resource.data.studentName.size() > 0
                    && request.resource.data.teacherName is string
                    && request.resource.data.teacherName.size() > 0
                    && request.resource.data.days is list
                    && request.resource.data.days.size() > 0
                    && request.resource.data.days.size() <= 7
                    && request.resource.data.durationMin is int
                    && request.resource.data.durationMin > 0
                    && request.resource.data.durationMin <= 240
                    && request.resource.data.status in ['active', 'paused'];

      allow update: if (isStaff()
                        && request.resource.data.status in ['active', 'paused'])
                    // A teacher owns the meeting room for their own class, so
                    // they may set the link and nothing else. Who teaches whom
                    // and when stays a staff decision.
                    || (isSignedIn()
                        && resource.data.teacherName == myName()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['zoomUrl']));

      allow delete: if isStaff();
    }

    match /messages/{messageId} {
      // A person may only read threads they are part of. Combined with the
      // participant filter on the client query, nobody can enumerate another
      // person's conversation.
      //
      // The Super Admin is the exception: oversight of every conversation is
      // the point of the role, and moderation is impossible without it.
      allow read: if isAdmin()
                  || (isSignedIn() && myName() in resource.data.participants);

      // The sender must be the signed-in person and must be a participant,
      // so a message cannot be forged in someone else's name.
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly([
                         'threadId', 'fromName', 'fromRole',
                         'participants', 'body', 'sentAt', 'readBy'
                       ])
                    && request.resource.data.fromName == myName()
                    && myName() in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 4000;

      // Updates exist only to record read receipts: a participant may add
      // themselves to readBy and change nothing else.
      allow update: if isSignedIn()
                    && myName() in resource.data.participants
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['readBy'])
                    && request.resource.data.body == resource.data.body
                    && request.resource.data.fromName == resource.data.fromName;

      // Messages are a record; only the Super Admin may remove one.
      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- */
    /* Complaints                                                       */
    /* ---------------------------------------------------------------- */

    match /complaints/{complaintId} {
      allow create: if isSignedIn();
      allow read: if isStaff() || isSelf(resource.data.raisedById);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- */
    /* Leave requests                                                   */
    /* ---------------------------------------------------------------- */

    match /leaveRequests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isStaff() || isSelf(resource.data.userId);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------------- */
    /* Finance — staff only, never client-writable                      */
    /* ---------------------------------------------------------------- */

    match /invoices/{invoiceId} {
      allow read: if isStaff() || isSelf(resource.data.studentId);
      allow write: if isStaff();
    }

    match /payments/{paymentId} {
      allow read: if isStaff();
      // Written exclusively by Cloud Functions via the Admin SDK,
      // which bypasses these rules.
      allow write: if false;
    }

    /* ---------------------------------------------------------------- */
    /* Anything not matched above is denied                             */
    /* ---------------------------------------------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
